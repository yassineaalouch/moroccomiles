{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moroccomiles-booking-handler",
  "main": "workers/booking-handler/index.ts",
  "compatibility_date": "2026-09-20",
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,https://moroccomiles.com,https://www.moroccomiles.com",
    "BOOKING_NOTIFY_EMAIL": "reservations@moroccomiles.com",
    "RESEND_FROM": "MoroccoMiles <reservations@moroccomiles.com>"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "reservations@moroccomiles.com",
      "allowed_sender_addresses": ["reservations@moroccomiles.com"]
    }
  ]
}
